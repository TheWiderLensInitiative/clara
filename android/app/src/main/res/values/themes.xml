<resources>
    <style name="Theme.Clara" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/clara_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Clara.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/clara_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Clara</item>
    </style>
</resources>
